# ============================================================
# DocuFlow AI - Backend Environment Variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma separated list of allowed origins for CORS (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# ---------- Supabase ----------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key (safe for browsers, protected by Row Level Security)
SUPABASE_ANON_KEY=
# Service role key - BACKEND ONLY. Bypasses RLS. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket used for uploaded documents
SUPABASE_STORAGE_BUCKET=documents

# ---------- AI Provider ----------
# mock | openai | anthropic | gemini | openrouter
# Use `mock` to run the full pipeline with the built-in heuristic/demo engine.
AI_PROVIDER=mock
AI_API_KEY=
# Optional model override per provider
AI_MODEL=
# openai: gpt-4o-mini | anthropic: claude-3-5-sonnet-latest | gemini: gemini-1.5-flash
AI_BASE_URL=
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=45000

# ---------- OCR / Vision Provider ----------
# mock | local-pdf | openai-vision | gemini-vision | google-vision | azure-vision
# `local-pdf` extracts embedded text from text-based PDFs with zero external APIs.
# `mock` uses the bundled demo corpus (great for hackathon demos).
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_BASE_URL=
OCR_TIMEOUT_MS=45000

# ---------- Upload limits ----------
MAX_FILE_SIZE_MB=15
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png

# ---------- Auth ----------
# Secret used to sign demo-mode session tokens (only used when Supabase is not configured)
DEMO_JWT_SECRET=change-me-in-production
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# ---------- Logging ----------
# error | warn | info | debug
LOG_LEVEL=info
