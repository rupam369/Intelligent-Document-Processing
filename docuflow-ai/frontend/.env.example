# DocuFlow AI - Frontend environment variables
# Copy to `.env` (or `.env.local`) and adjust if your API is not proxied.

# Base URL for the backend API. In development the Vite proxy forwards /api to
# the Express server, so the default relative value works out of the box.
VITE_API_URL=/api

# Only needed when the frontend is served from a different origin than the API
# (for example a separate production deployment).
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
